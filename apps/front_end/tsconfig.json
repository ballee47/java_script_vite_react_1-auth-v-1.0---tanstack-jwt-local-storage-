{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"]
    },

    "types": ["vite/client"],

    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}